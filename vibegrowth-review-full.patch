+    input.businessName.trim().toLowerCase().replace(/\s+/g, " "),
+    input.industry,
+    input.serviceArea.trim().toLowerCase().replace(/\s+/g, " "),
+  ].join("|");
+  return hashAbuseKey("fp", canonical);
