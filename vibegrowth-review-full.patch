+  }
+
+  async saveAuditDraftFailure(
+    auditId: string,
+    draftStatus: Extract<AuditDraftStatus, "unavailable" | "failed">,
+    reason: string
+  ): Promise<AuditRecord | null> {
+    const docRef = this.db.collection("audits").doc(auditId);
