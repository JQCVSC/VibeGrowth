+    );
+  }
+
+  const industry = typeof body.industry === "string" ? body.industry.trim() : "";
+  if (!ALLOWED_AUDIT_INDUSTRIES.includes(industry as AuditIndustry)) {
+    throw new AuditValidationError("Please select a valid industry.");
