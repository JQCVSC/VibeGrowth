+  async findRecentDuplicateAudit(params: {
+    fingerprintKey: string;
+    submissionIdKey: string | null;
+    nowMs?: number;
+  }): Promise<AuditRecord | null> {
+    const nowMs = params.nowMs ?? Date.now();
+    const refs = [
+      params.submissionIdKey ? this.db.collection("audit_dedup").doc(params.submissionIdKey) : null,
+      this.db.collection("audit_dedup").doc(params.fingerprintKey),
+    ].filter((ref): ref is NonNullable<typeof ref> => ref !== null);
+
+    for (const ref of refs) {
+      const snap = await ref.get();
+      if (snap.exists) {
+        const data = snap.data() as { auditId?: string; expiresAtMs?: number };
+        if (
+          typeof data?.auditId === "string" &&
+          typeof data?.expiresAtMs === "number" &&
+          data.expiresAtMs > nowMs
+        ) {
+          const existing = await this.getAuditById(data.auditId);
+          if (existing) {
+            return existing;
+          }
+        }
+      }
+    }
+    return null;
+  }
+
+  async claimOrCreateAuditRequest(
+    params: ClaimOrCreateAuditParams
+  ): Promise<{ audit: AuditRecord; isDuplicate: boolean }> {
+    const nowMs = params.nowMs ?? Date.now();
+    const dedupWindowMs = params.dedupWindowMs ?? DEFAULT_AUDIT_DEDUP_WINDOW_MS;
+    const fpRef = this.db.collection("audit_dedup").doc(params.fingerprintKey);
+    const sidRef = params.submissionIdKey
+      ? this.db.collection("audit_dedup").doc(params.submissionIdKey)
+      : null;
+
+    return this.db.runTransaction(async (tx) => {
+      const fpSnap = await tx.get(fpRef);
+      const sidSnap = sidRef ? await tx.get(sidRef) : null;
+
+      const candidateAuditIds: string[] = [];
+      for (const snap of [sidSnap, fpSnap]) {
+        if (snap && snap.exists) {
+          const data = snap.data() as { auditId?: string; expiresAtMs?: number };
+          if (
+            typeof data?.auditId === "string" &&
+            typeof data?.expiresAtMs === "number" &&
+            data.expiresAtMs > nowMs
+          ) {
+            candidateAuditIds.push(data.auditId);
+          }
+        }
+      }
+
+      for (const existingAuditId of candidateAuditIds) {
+        const existingSnap = await tx.get(this.db.collection("audits").doc(existingAuditId));
+        if (existingSnap.exists) {
+          return {
+            audit: mapAuditDoc(existingSnap.id, existingSnap.data() || {}),
+            isDuplicate: true,
+          };
+        }
+      }
+
+      const docRef = this.db.collection("audits").doc();
+      const nowIso = new Date(nowMs).toISOString();
+      const payload = {
+        ...params.input,
+        reviewStatus: "pending_review" as AuditReviewStatus,
+        draftStatus: "generating" as AuditDraftStatus,
+        draft: null,
+        draftError: null,
+        reviewedBy: null,
+        reviewedAt: null,
+        reviewerNotes: "",
+        createdAt: FieldValue.serverTimestamp(),
+        updatedAt: FieldValue.serverTimestamp(),
+      };
+
+      tx.set(docRef, payload);
+      const lockPayload = {
+        auditId: docRef.id,
+        expiresAtMs: nowMs + dedupWindowMs,
+        createdAt: FieldValue.serverTimestamp(),
+      };
+      tx.set(fpRef, lockPayload);
+      if (sidRef) {
+        tx.set(sidRef, lockPayload);
+      }
+
+      return {
+        audit: mapAuditDoc(docRef.id, {
+          ...payload,
+          createdAt: nowIso,
+          updatedAt: nowIso,
+        }),
+        isDuplicate: false,
+      };
+    });
+  }
