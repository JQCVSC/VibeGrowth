+  async findRecentDuplicateAudit(params: {
+    fingerprintKey: string;
+    submissionIdKey: string | null;
+    nowMs?: number;
+  }): Promise<AuditRecord | null> {
+    const nowMs = params.nowMs ?? Date.now();
+    const keys = [params.submissionIdKey, params.fingerprintKey].filter(
+      (k): k is string => Boolean(k)
+    );
+    for (const key of keys) {
+      const entry = this.dedup.get(key);
+      if (entry && entry.expiresAtMs > nowMs) {
+        const existing = this.audits.get(entry.auditId);
+        if (existing) return existing;
+      }
+    }
+    return null;
+  }
+
+  async claimOrCreateAuditRequest(
+    params: ClaimOrCreateAuditParams
+  ): Promise<{ audit: AuditRecord; isDuplicate: boolean }> {
+    const nowMs = params.nowMs ?? Date.now();
+    const dedupWindowMs = params.dedupWindowMs ?? 15 * 60 * 1000;
+    const keys = [params.submissionIdKey, params.fingerprintKey].filter(
+      (k): k is string => Boolean(k)
+    );
+
+    for (const key of keys) {
+      const entry = this.dedup.get(key);
+      if (entry && entry.expiresAtMs > nowMs) {
+        const existing = this.audits.get(entry.auditId);
+        if (existing) {
+          return { audit: existing, isDuplicate: true };
+        }
+      }
+    }
+
+    const created = await this.createAuditRequest(params.input);
+    for (const key of keys) {
+      this.dedup.set(key, { auditId: created.id, expiresAtMs: nowMs + dedupWindowMs });
+    }
+    return { audit: created, isDuplicate: false };
+  }
