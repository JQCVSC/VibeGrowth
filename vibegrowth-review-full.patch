+  async createAuditRequest(input: CreateAuditInput): Promise<AuditRecord> {
+    const docRef = this.db.collection("audits").doc();
+    const payload = {
+      ...input,
+      reviewStatus: "pending_review" as AuditReviewStatus,
+      draftStatus: "generating" as AuditDraftStatus,
+      draft: null,
+      draftError: null,
+      reviewedBy: null,
