+  if (businessName.length < 1 || businessName.length > 120) {
+    throw new AuditValidationError("Business name must be between 1 and 120 characters.");
+  }
+  if (findEmbeddedContactOrUrl(businessName)) {
+    throw new AuditValidationError(
