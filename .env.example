# Server port (hosting providers inject PORT automatically; defaults to 3000 locally)
PORT="3000"

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optional Gemini AI API key (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Stripe Configuration (NEVER commit real keys; use test keys until launch)
STRIPE_SECRET_KEY="sk_test_replace_with_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_webhook_secret"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_publishable_key"

# Firebase Admin SDK Configuration (server-side only)
# Option A: Inline JSON string of a Firebase service account key from secret manager
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B: Path to a mounted service account JSON file (or leave blank on Cloud Run ADC)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Optional Firebase overrides (defaults to firebase-applet-config.json values)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""

# Bootstrap admin email fallback (must match a verified Firebase Auth email)
ADMIN_EMAIL="owner@example.com"
